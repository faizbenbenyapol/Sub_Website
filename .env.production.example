# ค่าสำหรับ production บน Ubuntu server — คัดลอกเป็น .env ข้างไฟล์ docker-compose.prod.yml แล้วเติมค่า (ห้าม commit)
# สุ่มค่าลับ: openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 48

# โดเมนที่ชี้ A record มาที่ server (ไม่ใส่ https://)
DOMAIN=tadyang.example.com
APP_URL=https://tadyang.example.com

# ฐานข้อมูล (ใช้เฉพาะ A-Z a-z 0-9 เพราะอยู่ใน URL)
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ≥ 32 ตัว — เปลี่ยนแล้วทุกคนหลุดออกจากระบบ
SESSION_SECRET=
CRON_SECRET=

# อีเมลผ่าน Gmail App Password (ดู README หัวข้ออีเมลแจ้งเตือน)
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ตัดยัง? <your-project@gmail.com>"

# เข้าสู่ระบบด้วย Google (ไม่บังคับ — เว้นว่างไว้ปุ่มจะไม่แสดง) ดู docs/05-deploy.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ใช้ตอนรัน seed ครั้งแรกเท่านั้น (สร้างบัญชี admin) — DEMO_* เว้นว่างได้บน production
ADMIN_EMAIL=
ADMIN_PASSWORD=
